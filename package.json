{
  "name": "backfup",
  "version": "0.1.0",
  "description": "Postgres backup CLI — wrap pg_dump/pg_restore with multi-database and S3 support",
  "type": "module",
  "bin": {
    "backfup": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "tsup",
    "start": "bun run dist/bin.js",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "postgresql",
    "pg_dump",
    "pg_restore",
    "backup",
    "s3",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "inquirer": "^12.4.0",
    "ora": "^8.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.1.0"
  }
}
