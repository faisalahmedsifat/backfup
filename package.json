{
  "name": "@xyph3r/backfup",
  "version": "0.1.1",
  "description": "Postgres backup CLI — wrap pg_dump/pg_restore with multi-database and S3 support",
  "author": "xyph3r",
  "license": "MIT",
  "type": "module",
  "bin": {
    "backfup": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisalahmedsifat/backfup.git"
  },
  "bugs": {
    "url": "https://github.com/faisalahmedsifat/backfup/issues"
  },
  "homepage": "https://github.com/faisalahmedsifat/backfup#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "tsup",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgresql",
    "pg_dump",
    "pg_restore",
    "backup",
    "s3",
    "cli"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "inquirer": "^12.4.0",
    "ora": "^8.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
